import numpy as np

# Define the 3 x 4 grid
n_rows, n_cols = 3, 4
grid_world = np.zeros((n_rows, n_cols))

# Define rewards
rewards = {
    (0, 3): 10,     # Cheese state
    (1, 3): -10     # Penalty state
}

# Discount factor
gamma = 0.9

# Define actions
actions = [
    (0, 1),    # Right
    (0, -1),   # Left
    (1, 0),    # Down
    (-1, 0)    # Up
]

action_names = [
    "Right",
    "Left",
    "Down",
    "Up"
]


# Bellman update for a state and action
def bellman_update(i, j, action_index):

    # If it is a reward state
    if (i, j) in rewards:
        return rewards[(i, j)]

    # Calculate next state
    di, dj = actions[action_index]

    next_i = i + di
    next_j = j + dj

    # Invalid movement
    if not (0 <= next_i < n_rows and 0 <= next_j < n_cols):
        return -np.inf

    # Get reward of next state
    reward = rewards.get((next_i, next_j), 0)

    # Bellman equation
    return reward + gamma * grid_world[next_i, next_j]


# Perform value iteration
num_iterations = 100

for _ in range(num_iterations):

    new_grid_world = np.copy(grid_world)

    for i in range(n_rows):
        for j in range(n_cols):

            # Keep reward states fixed
            if (i, j) in rewards:
                new_grid_world[i, j] = rewards[(i, j)]
                continue

            values = []

            for action_index in range(len(actions)):
                value = bellman_update(
                    i, j, action_index
                )
                values.append(value)

            # Select maximum value
            new_grid_world[i, j] = max(values)

    grid_world = new_grid_world


# Calculate optimal policy
optimal_policy = np.empty(
    (n_rows, n_cols),
    dtype=object
)

for i in range(n_rows):
    for j in range(n_cols):

        if (i, j) in rewards:
            if rewards[(i, j)] == 10:
                optimal_policy[i, j] = "CHEESE"
            else:
                optimal_policy[i, j] = "PENALTY"
            continue

        policy_values = []

        for action_index in range(len(actions)):
            value = bellman_update(
                i, j, action_index
            )
            policy_values.append(value)

        best_action = np.argmax(policy_values)

        optimal_policy[i, j] = action_names[best_action]


# Print state values
print("State Values:")
print("----------------")

print(np.round(grid_world, 2))


# Print optimal policy
print("\nOptimal Policy:")
print("----------------")

for row in optimal_policy:
    print(" | ".join(row))
