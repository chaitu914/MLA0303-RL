import numpy as np

# Define the grid world
# 2 rows and 5 columns
n_rows, n_cols = 2, 5

grid_world = np.zeros((n_rows, n_cols))


# Define rewards
# Python uses 0-based indexing
#
# (1,4) in the question -> (0,3) in Python
# (2,4) in the question -> (1,3) in Python

rewards = {
    (0, 3): 1,     # Maximum reward
    (1, 3): 1,     # Maximum reward
    (0, 2): -1,    # Fire
    (1, 2): -1     # Fire
}


# Discount factor
gamma = 0.9


# Possible actions
actions = [
    (0, 1),    # Right
    (0, -1),   # Left
    (1, 0),    # Down
    (-1, 0)    # Up
]

action_names = [
    "Right",
    "Left",
    "Down",
    "Up"
]


# Bellman update
def bellman_update(i, j, action_index):

    # Reward states
    if (i, j) in rewards:
        return rewards[(i, j)]

    # Find next state
    di, dj = actions[action_index]

    next_i = i + di
    next_j = j + dj

    # Invalid movement
    if not (0 <= next_i < n_rows and
            0 <= next_j < n_cols):
        return -np.inf

    # Reward of next state
    reward = rewards.get(
        (next_i, next_j), 0
    )

    # Bellman equation
    return reward + gamma * grid_world[next_i, next_j]


# Value iteration
num_iterations = 100

for _ in range(num_iterations):

    new_grid_world = np.copy(grid_world)

    for i in range(n_rows):
        for j in range(n_cols):

            # Keep reward states fixed
            if (i, j) in rewards:
                new_grid_world[i, j] = rewards[(i, j)]
                continue

            values = []

            # Calculate value for every action
            for action_index in range(4):

                value = bellman_update(
                    i, j, action_index
                )

                values.append(value)

            # Select maximum value
            new_grid_world[i, j] = max(values)

    grid_world = new_grid_world


# Find optimal policy
optimal_policy = np.empty(
    (n_rows, n_cols),
    dtype=object
)

for i in range(n_rows):
    for j in range(n_cols):

        if (i, j) in rewards:

            optimal_policy[i, j] = "Reward"

        else:

            values = []

            for action_index in range(4):

                value = bellman_update(
                    i, j, action_index
                )

                values.append(value)

            best_action = np.argmax(values)

            optimal_policy[i, j] = action_names[
                best_action
            ]


# Print state values
print("State Values:")
print("----------------")

print(np.round(grid_world, 2))


# Print optimal policy
print("\nOptimal Policy:")
print("----------------")

for row in optimal_policy:
    print(" | ".join(row))
