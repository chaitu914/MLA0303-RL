import gymnasium as gym
import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim

# Create environment
env = gym.make("CartPole-v1")


# Neural Network
class PolicyNetwork(nn.Module):

    def __init__(self, input_size, output_size):
        super().__init__()

        self.fc = nn.Sequential(
            nn.Linear(input_size, 128),
            nn.ReLU(),
            nn.Linear(128, output_size),
            nn.Softmax(dim=-1)
        )

    def forward(self, x):
        return self.fc(x)


# Agent
class Agent:

    def __init__(self, input_size, output_size):

        self.policy_network = PolicyNetwork(
            input_size,
            output_size
        )

        self.optimizer = optim.Adam(
            self.policy_network.parameters(),
            lr=0.001
        )

        self.output_size = output_size

    def select_action(self, state):

        state = torch.tensor(
            state,
            dtype=torch.float32
        )

        probabilities = self.policy_network(state)

        # Select action according to probabilities
        action = np.random.choice(
            np.arange(self.output_size),
            p=probabilities.detach().numpy()
        )

        return action


# Create Agent
agent = Agent(
    input_size=env.observation_space.shape[0],
    output_size=env.action_space.n
)


# Training
num_episodes = 100

for episode in range(num_episodes):

    # Reset environment
    state, info = env.reset()

    total_reward = 0

    while True:

        # Agent selects action
        action = agent.select_action(state)

        # Environment responds
        next_state, reward, terminated, truncated, info = env.step(action)

        # Calculate action probability
        state_tensor = torch.tensor(
            state,
            dtype=torch.float32
        )

        probabilities = agent.policy_network(state_tensor)

        action_tensor = torch.tensor(action)

        log_prob = torch.log(
            probabilities[action_tensor]
        )

        # Calculate loss
        loss = -log_prob * reward

        # Update neural network
        agent.optimizer.zero_grad()
        loss.backward()
        agent.optimizer.step()

        # Update state and reward
        state = next_state
        total_reward += reward

        # Check whether episode has ended
        if terminated or truncated:
            break

    if episode % 10 == 0:
        print(
            f"Episode {episode}, "
            f"Total Reward: {total_reward}"
        )


env.close()
